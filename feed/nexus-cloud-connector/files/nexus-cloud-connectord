		json_add_boolean invoke_interactions_v1 1
		json_add_boolean mcp_stream_v1 1
		json_add_boolean mcp_tasks_v1 1
		json_add_boolean caller_mobile_v1 1
		json_add_boolean durable_recovery_v1 1
	else
