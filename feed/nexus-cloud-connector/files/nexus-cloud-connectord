sync_once() {
	local snapshot_dir=$RUNTIME_DIR/snapshot.$$ new_state=$RUNTIME_DIR/registrations.$$.tsv
	local new_cloud_state=$RUNTIME_DIR/agent-registrations.$$.tsv
	local generation agent_dir origin route_id address healthy registration_id old_id selected
	local registered=0 eligible=0 skipped=0 payload response id old_origin
	local agent_mcp_path skip_reason='' selected_transport direct_ready=0 relay_ready=0
	local relay_active active_relay_id active_assignment_id relay_remaining relay_tunnels_up
	local formal_agent_id runtime_id cloud_mcp_url provisioning_state manifest_digest status_message
	local registration_output registration_result
	SYNC_PRESENCE_STATE=degraded
	STATUS_REGISTRATION_HTTP_CODE=0
	STATUS_REGISTRATION_ERROR_CODE=''
	SNAPSHOT_ERROR_STAGE=''
	STATUS_RELAY_READY=0
	set_recovery_status automatic_retry "$recovery_interval"
	mkdir -p "$snapshot_dir" || return 1
	if ! extract_snapshot "$snapshot_dir"; then
		rm -rf "$snapshot_dir"
		write_status snapshot_failed "Could not read the local Agent snapshot at ${SNAPSHOT_ERROR_STAGE:-unknown}." 0 0 0
		return 1
	fi
	if direct_ingress_ready; then
		direct_ready=1
	fi
	IFS="$TAB" read -r relay_active active_relay_id active_assignment_id relay_remaining relay_tunnels_up <"$snapshot_dir/relay.tsv"
	STATUS_RELAY_ID="$active_relay_id"
	STATUS_RELAY_ASSIGNMENT_ID="$active_assignment_id"
	STATUS_RELAY_TUNNELS_UP="$relay_tunnels_up"
	STATUS_ACTIVE_TRANSPORT=''
	case "$relay_active" in 1|true) ;; *) relay_active=0 ;; esac
	case "$relay_tunnels_up" in ''|*[!0-9]*) relay_tunnels_up=0 ;; esac
	if [ "$relay_active" != 0 ] && [ -n "$active_relay_id" ] &&
		[ -n "$active_assignment_id" ] && [ "$relay_tunnels_up" -gt 0 ]; then
		relay_ready=1
	fi
	STATUS_RELAY_READY="$relay_ready"
	if [ "$cloud_transport" = direct_ipv6 ] && [ "$direct_ready" -ne 1 ]; then
		rm -rf "$snapshot_dir"
		write_status direct_ingress_unavailable "Direct IPv6 requires a valid managed server certificate and a live mTLS listener on the public ingress port." 0 0 0
		return 1
	fi
	if [ "$cloud_transport" = relay ] && [ "$relay_ready" -ne 1 ]; then
		rm -rf "$snapshot_dir"
		write_status relay_unavailable "Relay mode requires a live Directory lease and established outbound tunnel." 0 0 0
		return 1
	fi
	if [ "$cloud_transport" = auto ] && [ "$direct_ready" -ne 1 ] && [ "$relay_ready" -ne 1 ]; then
		rm -rf "$snapshot_dir"
		write_status no_cloud_transport "Neither Direct IPv6 nor an active Relay tunnel is available." 0 0 0
		return 1
	fi
	generation="$(next_generation)" || return 1
	: >"$new_state"
	: >"$new_cloud_state"
	for agent_dir in "$snapshot_dir"/agent-*; do
		[ -d "$agent_dir" ] || continue
		origin="$(cat "$agent_dir/origin")"
		healthy="$(cat "$agent_dir/healthy")"
		selected="$(select_public_route "$agent_dir/capabilities" "$snapshot_dir/addresses.tsv" || true)"
		route_id="${selected%%"$TAB"*}"
		address="${selected#*"$TAB"}"
		[ "$selected" != "$address" ] || address=''
		[ -n "$route_id" ] || route_id="$(cat "$agent_dir/route-id")"
		selected_transport=''
		if [ "$cloud_transport" != relay ] && [ "$direct_ready" -eq 1 ] && [ -n "$address" ]; then
			selected_transport=direct_ipv6
		elif [ "$cloud_transport" != direct_ipv6 ] && [ "$relay_ready" -eq 1 ]; then
			selected_transport=relay
		fi
		if [ "$healthy" != 1 ] || [ -z "$route_id" ] || [ -z "$selected_transport" ] || [ ! -s "$agent_dir/capabilities" ]; then
			skipped=$((skipped + 1))
			old_id="$(old_id_for_origin "$origin" || true)"
			[ -z "$old_id" ] || printf '%s\t%s\n' "$old_id" "$origin" >>"$new_state"
			continue
		fi
		agent_mcp_path=''
		mcp_path_status=0
		if [ "$selected_transport" = direct_ipv6 ]; then
			agent_mcp_path="$(mcp_path_for_origin "$origin")" || mcp_path_status=$?
		fi
		if [ "$mcp_path_status" -ne 0 ]; then
			skipped=$((skipped + 1))
			if [ "$mcp_path_status" -eq 2 ]; then
				skip_reason='origin_mcp_path_exceeds_255_bytes'
				log "Skipping Agent origin because its encoded MCP path exceeds 255 bytes."
			else
				skip_reason='origin_mcp_path_encoding_failed'
				log "Skipping Agent origin because it cannot be encoded as a canonical MCP path."
			fi
			old_id="$(old_id_for_origin "$origin" || true)"
			[ -z "$old_id" ] || printf '%s\t%s\n' "$old_id" "$origin" >>"$new_state"
			continue
		fi
		eligible=$((eligible + 1))
		payload=$snapshot_dir/register.$eligible.json
		response=$snapshot_dir/register.$eligible.response
		registration_output=$snapshot_dir/register.$eligible.id
		LAST_HTTP_CODE=0
		LAST_ERROR_CODE=''
		registration_result=0
		if register_agent "$agent_dir" "$address" "$generation" "$route_id" \
			"$payload" "$response" "$agent_mcp_path" "$selected_transport" \
			"$active_relay_id" "$active_assignment_id" >"$registration_output"; then
			registration_id="$(cat "$registration_output")"
		else
			registration_result=$?
			registration_id=''
		fi
		rm -f "$registration_output"
		if [ -n "$registration_id" ]; then
			formal_agent_id="$(json_data_value "$response" agent_id || true)"
			runtime_id="$(json_data_value "$response" runtime_id || true)"
			cloud_mcp_url="$(json_data_value "$response" mcp_url || true)"
			provisioning_state="$(json_data_value "$response" provisioning_state || true)"
			manifest_digest="$(cat "$agent_dir/manifest-digest" 2>/dev/null || true)"
			if [ -z "$provisioning_state" ]; then
				if [ -n "$formal_agent_id" ] && [ -n "$runtime_id" ] &&
					[ -n "$cloud_mcp_url" ]; then
					provisioning_state=ready
				else
					provisioning_state=pending
				fi
			fi
			status_message=''
			printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
				"$origin" "$provisioning_state" "$registration_id" \
				"$formal_agent_id" "$runtime_id" "$selected_transport" \
				"$cloud_mcp_url" "$manifest_digest" \
				"$(b64_encode "$status_message")" >>"$new_cloud_state"
			if [ -z "$STATUS_ACTIVE_TRANSPORT" ]; then
				STATUS_ACTIVE_TRANSPORT="$selected_transport"
			elif [ "$STATUS_ACTIVE_TRANSPORT" != "$selected_transport" ]; then
				STATUS_ACTIVE_TRANSPORT=mixed
			fi
			printf '%s\t%s\n' "$registration_id" "$origin" >>"$new_state"
			registered=$((registered + 1))
		else
			STATUS_REGISTRATION_HTTP_CODE="$LAST_HTTP_CODE"
			STATUS_REGISTRATION_ERROR_CODE="$LAST_ERROR_CODE"
			manifest_digest="$(cat "$agent_dir/manifest-digest" 2>/dev/null || true)"
			provisioning_state=degraded
			status_message="${LAST_ERROR_CODE:-Cloud registration is temporarily unavailable.}"
			if [ "$registration_result" -eq 2 ] ||
				case "$LAST_HTTP_CODE" in 4??) true ;; *) false ;; esac; then
				provisioning_state=rejected
			fi
			if [ "$registration_result" -eq 2 ]; then
				skip_reason=mapping_conflict
				[ "$STATUS_RECOVERY_ACTION" = reauthorize ] ||
					set_recovery_status fix_agent_configuration "$sync_interval"
			else
				classify_cloud_recovery
			fi
			printf '%s|%s||||%s||%s|%s\n' \
				"$origin" "$provisioning_state" "$selected_transport" \
				"$manifest_digest" "$(b64_encode "$status_message")" \
				>>"$new_cloud_state"
			old_id="$(old_id_for_origin "$origin" || true)"
			[ -z "$old_id" ] || printf '%s\t%s\n' "$old_id" "$origin" >>"$new_state"
			skipped=$((skipped + 1))
		fi
	done

	if [ -r "$REGISTRATION_STATE" ]; then
		while IFS="$TAB" read -r id old_origin; do
			[ -n "$id" ] && [ -n "$old_origin" ] || continue
			grep -Fqx -e "$old_origin" "$snapshot_dir/local-origins" && continue
			withdraw_registration "$id" || true
		done <"$REGISTRATION_STATE"
	fi
	mv -f "$new_state" "$REGISTRATION_STATE"
	write_agent_registration_status "$new_cloud_state" "$generation" || true
	rm -f "$new_cloud_state"
	rm -rf "$snapshot_dir"
	if [ "$registered" -eq "$eligible" ] && [ "$skipped" -eq 0 ] && [ -z "$skip_reason" ]; then
		SYNC_PRESENCE_STATE=online
		clear_recovery_status
		write_status online "Cloud Agent leases are current through Direct IPv6 or Relay." "$registered" "$eligible" "$skipped"
	else
		SYNC_PRESENCE_STATE=degraded
		write_status degraded "One or more eligible Agents could not be renewed or published." "$registered" "$eligible" "$skipped" "$skip_reason"
	fi
	return 0
}

withdraw_all() {
	local id origin
	[ -r "$token_file" ] && [ -r "$REGISTRATION_STATE" ] || return 0
	while IFS="$TAB" read -r id origin; do
		[ -n "$id" ] && withdraw_registration "$id" || true
	done <"$REGISTRATION_STATE"
	: >"$REGISTRATION_STATE"
	: >"$RUNTIME_DIR/agent-registrations.empty.tsv"
	write_agent_registration_status \
		"$RUNTIME_DIR/agent-registrations.empty.tsv" 0 || true
	rm -f "$RUNTIME_DIR/agent-registrations.empty.tsv"
}

stop_connector() {
	STOPPING=1
	write_status stopping "Withdrawing cloud Agent leases." 0 0 0
	withdraw_all
	withdraw_presence || true
	rm -f "$AGENT_CLOUD_ENABLED" "$AGENT_CLOUD_ENROLLED" "$AGENT_CLOUD_TENANT_ID"
	exit 0
}

write_recoverable_cloud_failure() {
	local state="$1" message="$2"
	classify_cloud_recovery
	if [ "$STATUS_RECOVERY_ACTION" = reauthorize ]; then
		state=reauthorization_required
		message="Nexus Cloud rejected this Router identity. Generate a new one-time pairing code in Nexus Console and save it on the Router."
	fi
	write_status "$state" "$message" 0 0 0
}

prepare_cloud_runtime() {
	set_recovery_status automatic_retry "$recovery_interval"
	if [ "$REENROLLING" -eq 1 ] || [ ! -s "$token_file" ]; then
		if [ -z "$pairing_code" ]; then
			set_recovery_status supply_pairing_code "$sync_interval"
			write_status pairing_required "Paste a new one-time pairing code from Nexus Console." 0 0 0
			return 1
		fi
		if ! enroll_node; then
			if cloud_authorization_required || case "$LAST_HTTP_CODE" in 4??) true ;; *) false ;; esac; then
				set_recovery_status replace_pairing_code "$sync_interval"
				write_status pairing_rejected "The one-time pairing code was rejected or expired. Generate a new code in Nexus Console." 0 0 0
			else
				write_recoverable_cloud_failure enrollment_failed "Nexus Cloud enrollment is temporarily unavailable and will be retried automatically."
			fi
			return 1
		fi
		# Enrollment consumes the one-time code. Do not replay it on the next
		# recovery cycle after the new identity has been installed.
		REENROLLING=0
		pairing_code=''
	fi
	if ! synchronize_gateway_cloud_trust; then
		set_recovery_status automatic_retry "$recovery_interval"
		write_status auth_configuration_failed "Cloud TLS trust could not be synchronized to the LAN Agent Gateway. Nexus will retry automatically." 0 0 0
		return 1
	fi
	if ! renew_managed_identity; then
		write_recoverable_cloud_failure certificate_renewal_failed "The managed device certificate could not be renewed. Nexus will retry automatically."
		return 1
	fi
	if ! renew_managed_ingress_identity; then
		if [ "$cloud_transport" = direct_ipv6 ]; then
			write_recoverable_cloud_failure ingress_certificate_failed "The managed Direct IPv6 server certificate could not be renewed or activated. Nexus will retry automatically."
			return 1
		fi
		log "Direct IPv6 ingress identity refresh failed; auto mode may continue with Relay."
	fi
	printf '%s\n' enrolled >"$AGENT_CLOUD_ENROLLED.tmp.$$" &&
		chmod 0644 "$AGENT_CLOUD_ENROLLED.tmp.$$" &&
		mv -f "$AGENT_CLOUD_ENROLLED.tmp.$$" "$AGENT_CLOUD_ENROLLED" || {
		set_recovery_status automatic_retry "$recovery_interval"
		write_status local_state_failed "The local Cloud enrollment state could not be projected. Nexus will retry automatically." 0 0 0
		return 1
	}
	if [ "$cloud_transport" = direct_ipv6 ]; then
		disable_relay_configuration || {
			set_recovery_status automatic_retry "$recovery_interval"
			write_status relay_configuration_failed "The stale Relay configuration could not be disabled. Nexus will retry automatically." 0 0 0
			return 1
		}
		probe_cloud_relay_availability
	elif ! refresh_relay_configuration; then
		if [ "$cloud_transport" = relay ]; then
			if [ "$LAST_ERROR_CODE" = RELAY_NOT_CONFIGURED ]; then
				STATUS_CLOUD_RELAY_AVAILABLE=0
				set_recovery_status enable_relay_or_switch_transport "$sync_interval"
				write_status relay_not_configured "Nexus Cloud Relay is not configured. Select Direct IPv6 or ask the Cloud administrator to enable Relay." 0 0 0
			else
				write_recoverable_cloud_failure relay_configuration_failed "The Relay Directory or trust configuration could not be refreshed. Nexus will retry automatically."
			fi
			return 1
		fi
		log "Relay configuration refresh failed; auto mode may continue with Direct IPv6."
	fi
	clear_recovery_status
	return 0
}

main() {
	umask 077
	mkdir -p "$RUNTIME_DIR" /etc/nexus-cloud
	chmod 0700 "$RUNTIME_DIR" /etc/nexus-cloud
	trap stop_connector TERM INT
	if ! load_configuration; then
		write_status configuration_error "Nexus Cloud configuration is invalid." 0 0 0
		exit 1
	fi
	[ "$enabled" -eq 1 ] || exit 0
	case "$cloud_transport" in
		direct_ipv6) STATUS_LOCAL_RELAY_ENABLED=0 ;;
		auto|relay) STATUS_LOCAL_RELAY_ENABLED=1 ;;
	esac
	mkdir -p "$AGENT_CLOUD_STATUS_DIR" || exit 1
	chmod 0755 "$AGENT_CLOUD_STATUS_DIR" || exit 1
	printf '%s\n' "$cloud_transport" >"$AGENT_CLOUD_ENABLED.tmp.$$" &&
		chmod 0644 "$AGENT_CLOUD_ENABLED.tmp.$$" &&
		mv -f "$AGENT_CLOUD_ENABLED.tmp.$$" "$AGENT_CLOUD_ENABLED" || exit 1
	if [ -s "$CLOUD_TENANT_ID_FILE" ]; then
		project_cloud_tenant_id "$(cat "$CLOUD_TENANT_ID_FILE")" || exit 1
	fi
	if [ -n "$pairing_code" ] && [ -s "$token_file" ]; then
		REENROLLING=1
		write_status reenrolling "Replacing the existing Cloud registration with the supplied one-time pairing code." 0 0 0
		log "explicit pairing code requested Cloud identity replacement"
	fi
	write_status connecting "Synchronizing local public IPv6 Agents." 0 0 0
	while [ "$STOPPING" -eq 0 ]; do
		if prepare_cloud_runtime; then
			if sync_once; then
				if ! renew_presence "${SYNC_PRESENCE_STATE:-online}"; then
					write_recoverable_cloud_failure presence_failed "Cloud Router presence renewal failed. Nexus will retry automatically."
				fi
			else
				if ! renew_presence degraded; then
					write_recoverable_cloud_failure presence_failed "Cloud Router presence renewal failed. Nexus will retry automatically."
				fi
			fi
		else
			# Preserve a degraded Router lease while a recoverable local Relay,
			# certificate, or Gateway prerequisite is being repaired. A revoked
			# credential cannot renew Presence and remains explicitly blocked.
			renew_presence degraded >/dev/null 2>&1 || true
		fi
		retry_delay="$(current_retry_delay)"
		STATUS_NEXT_RETRY_SECONDS="$retry_delay"
		sleep "$retry_delay" &
		wait $!
	done
}

main "$@"
