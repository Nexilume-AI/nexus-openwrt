#!/bin/sh /etc/rc.common

USE_PROCD=1
START=97
STOP=15

start_service() {
	local enabled
	config_load nexus_cloud
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/nexus-cloud-connectord
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0 0" nofile="128 128"
	# agent and agent_gateway are managed by the connector itself. Watching
	# those files would restart this process in the middle of its own UCI
	# commit, before agentd can apply the new Relay generation.
	procd_set_param file /etc/config/nexus_cloud
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# The connector manages authenticated Agent/Agent Gateway trust settings
	# itself. Watching those files makes each successful Directory refresh
	# restart this service while it is still configuring agentd, creating a
	# procd crash loop. User-facing Cloud settings remain the reload boundary;
	# local Agent state is observed by the regular synchronization loop.
	procd_add_reload_trigger nexus_cloud
	# Do not restart an in-flight one-shot enrollment transaction for arbitrary
	# interface events.  The connector's bounded synchronization loop observes
	# network recovery without risking reuse of a consumed pairing code.
}
