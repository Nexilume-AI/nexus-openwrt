config cloud 'main'
	option enabled '0'
	# Authenticated Edge operations use this URL after enrollment.
	option base_url ''
	# Public one-time pairing URL. The connector preserves it when Cloud moves
	# authenticated traffic to a dedicated mTLS ingress.
	option enrollment_url ''
	# Paste a one-time code from Nexus Console. It is removed after enrollment.
	option pairing_code ''
	option display_name ''
	# auto prefers Direct IPv6 and falls back to an outbound Relay tunnel.
	# Values: auto, direct_ipv6, relay.
	option connectivity_mode 'auto'
	option sync_interval_seconds '120'
	option recovery_interval_seconds '30'
	option lease_seconds '300'
	option connect_timeout_seconds '10'
	option request_timeout_seconds '30'
	option token_file '/etc/nexus-cloud/device.token'
	option node_id_file '/etc/nexus-cloud/node.id'
	option client_cert '/etc/nexus-cloud/device.crt'
	option client_key '/etc/nexus-cloud/device.key'
	option identity_mode 'managed'
	option ca_file '/etc/ssl/certs/ca-certificates.crt'
	# Public enrollment/SDK trust; empty preserves legacy shared CA behavior.
	option public_ca_file ''
	# Optional override. Otherwise the SHA-256 fingerprint is read from client_cert.
	option device_cert_sha256 ''
	# Prefix only. The connector publishes /mcp/<percent-encoded Agent origin>.
	option mcp_path '/mcp/'
