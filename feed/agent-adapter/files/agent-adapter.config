config adapter 'main'
	option enabled '0'
	option listen '127.0.0.1:7790'
	option gateway_endpoint 'http://127.0.0.1:7788/agent/v1/invoke'
	option max_request_bytes '65536'
	option max_response_bytes '262144'
	option gateway_timeout_ms '5500'
	# Chat/Task/Interactive calls may remain open while the caller answers.
	option interactive_timeout_ms '3600000'
	option max_inflight '32'
	option stream_enabled '0'
	option stream_idle_timeout_ms '15000'
	option max_stream_event_bytes '65536'
	option default_tenant 'local'
	option source_agent 'agent://local/adapterd'
	option default_hop_limit '8'
	option default_region 'local'
	option jail '1'

# MCP uses the authenticated/connection-bound server identity plus the exact
# tools/call params.name. Tool arguments are never inspected to infer intent.
config mapping 'example_mcp_lint'
	option enabled '0'
	option protocol 'mcp'
	option authority 'eda-local'
	option selector 'lint_verilog'
	option intent 'chip.verilog.verify.lint'
	option version '1'
	option title 'Lint Verilog'
	option description 'Run deterministic Verilog lint on the selected Agent.'
	option input_schema_json '{"type":"object","properties":{"source":{"type":"string"}},"additionalProperties":false}'
	option task '0'
	option resumable '0'
	option demo '0'
	option chat '0'
	option interactive '0'

# A2A 1.0 message:send does not carry a normative skill selector. The ingress
# endpoint must supply the Agent Card identity and configured skill selector.
config mapping 'example_a2a_lint'
	option enabled '0'
	option protocol 'a2a'
	option authority 'chip-agent-card'
	option selector 'lint'
	option intent 'chip.verilog.verify.lint'
	option version '1'
