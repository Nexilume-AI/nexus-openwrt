#!/bin/sh /etc/rc.common

USE_PROCD=1
START=97
STOP=8

start_service() {
	local enabled listen gateway max_request max_response timeout max_inflight
	local tenant source_agent hop_limit region jail runtime_dir runtime_config
	local stream_enabled stream_idle_timeout max_stream_event interactive_timeout
	local lan_sdk_enabled public_ingress_enabled cloud_enabled manifest_file

	config_load agent_adapter
	config_get_bool enabled main enabled 0
	if [ "$enabled" -ne 1 ]; then
		config_load agent_gateway
		config_get_bool lan_sdk_enabled main lan_sdk_enabled 0
		config_get_bool public_ingress_enabled main public_ipv6_enabled 0
		config_load nexus_cloud
		config_get_bool cloud_enabled main enabled 0
		if [ "$lan_sdk_enabled" -eq 1 ] && {
			[ "$public_ingress_enabled" -eq 1 ] ||
			[ "$cloud_enabled" -eq 1 ]
		}; then
			enabled=1
		fi
		config_load agent_adapter
	fi
	[ "$enabled" -eq 1 ] || return 0

	config_get listen main listen 127.0.0.1:7790
	config_get gateway main gateway_endpoint \
		http://127.0.0.1:7788/agent/v1/invoke
	config_get max_request main max_request_bytes 65536
	config_get max_response main max_response_bytes 262144
	config_get timeout main gateway_timeout_ms 5500
	config_get interactive_timeout main interactive_timeout_ms 3600000
	config_get max_inflight main max_inflight 32
	config_get tenant main default_tenant local
	config_get source_agent main source_agent agent://local/adapterd
	config_get hop_limit main default_hop_limit 8
	config_get region main default_region local
	config_get_bool jail main jail 1
	config_get_bool stream_enabled main stream_enabled 0
	config_get stream_idle_timeout main stream_idle_timeout_ms 15000
	config_get max_stream_event main max_stream_event_bytes 65536
	manifest_file=/var/run/agent-manifests/manifests.json

	# UCI configuration files are intentionally root-only on OpenWrt.  Give the
	# unprivileged daemon a private, read-only snapshot instead of weakening the
	# permissions of /etc/config/agent_adapter.
	runtime_dir=/var/run/agent-adapter
	runtime_config="$runtime_dir/agent_adapter"
	mkdir -p "$runtime_dir" || return 1
	cp /etc/config/agent_adapter "$runtime_config" || return 1
	chown agent-adapter:agent-adapter "$runtime_dir" "$runtime_config" || return 1
	chmod 0750 "$runtime_dir" || return 1
	chmod 0400 "$runtime_config" || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/agent-adapterd
	procd_append_param command -a "$listen"
	procd_append_param command -g "$gateway"
	procd_append_param command -b "$max_request"
	procd_append_param command -R "$max_response"
	procd_append_param command -t "$timeout"
	procd_append_param command -I "$interactive_timeout"
	procd_append_param command -C "$max_inflight"
	procd_append_param command -T "$tenant"
	procd_append_param command -u "$source_agent"
	procd_append_param command -H "$hop_limit"
	procd_append_param command -r "$region"
	procd_append_param command -D "$runtime_dir"
	procd_append_param command -x "$stream_enabled"
	procd_append_param command -L "$stream_idle_timeout"
	procd_append_param command -E "$max_stream_event"
	procd_append_param command -M "$manifest_file"
	procd_set_param user agent-adapter
	procd_set_param group agent-adapter
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0 0" nofile="1024 1024"
	procd_set_param stdout 1
	procd_set_param stderr 1

	if [ "$jail" -eq 1 ]; then
		procd_add_jail agent-adapterd log procfs ronly requirejail
		procd_add_jail_mount "$runtime_config"
		[ ! -d /var/run/agent-manifests ] ||
			procd_add_jail_mount /var/run/agent-manifests
	fi

	procd_close_instance
}

reload_service() {
	# Re-enter start_service so the unprivileged runtime UCI snapshot is rebuilt.
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger agent_adapter
	procd_add_reload_trigger agent_gateway
	procd_add_reload_trigger nexus_cloud
}
