config card 'main'
	option enabled '0'
	option poll_seconds '30'
	option fetch_timeout_seconds '10'
	option trust_public_key '/etc/agentd/card-trust.pub'
	option expected_key_id 'nexus-card-2026'
	option expected_issuer 'nexus-local-trust'
	# P6.2.2: set both options to enable signed Directory trust bundles.
	# Empty directory_bundle_uri preserves the P6.2.1 pinned-key mode.
	option directory_bundle_uri ''
	option directory_root_public_key '/etc/agentd/directory-root.pub'
