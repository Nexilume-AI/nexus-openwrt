include $(TOPDIR)/rules.mk

PKG_NAME:=nexus-agent-profiles
PKG_VERSION:=1.0.0
PKG_RELEASE:=2
PKG_LICENSE:=Apache-2.0
PKG_MAINTAINER:=Nexus OpenWrt Team

include $(INCLUDE_DIR)/package.mk

# These metapackages only install profile metadata; there is no source to build.
define Build/Compile
endef

define Package/nexus-agent-profile/default
  SECTION:=net
  CATEGORY:=Network
  SUBMENU:=Routing and Redirection
  PKGARCH:=all
endef

define Package/nexus-agent-router
  $(call Package/nexus-agent-profile/default)
  TITLE:=Nexus Agent Router
  DEPENDS:=+agent-netd +agentd +agent-gw +agent-adapter \
	+nexus-cloud-connector +luci-app-agent-router +nexus-agent-roles
endef

define Package/nexus-agent-router/description
 Base Nexus Agent Router profile. It includes LAN Agent registration, routing,
 Cloud Direct IPv6/Relay client connectivity and the LuCI management UI. It
 does not install the self-hosted Node.js Relay or Directory services.
endef

define Package/nexus-agent-router-relay
  $(call Package/nexus-agent-profile/default)
  TITLE:=Nexus Agent Router with self-hosted Relay
  DEPENDS:=+nexus-agent-router +nexus-agent-relayd +nexus-node-runtime
endef

define Package/nexus-agent-router-relay/description
 Gateway-class profile that adds the self-hosted Open Mesh Relay and its
 bounded Node.js runtime to the base Nexus Agent Router.
endef

define Package/nexus-agent-router-seed
  $(call Package/nexus-agent-profile/default)
  TITLE:=Nexus Open Mesh Seed
  DEPENDS:=+nexus-agent-router-relay +nexus-agent-directoryd
endef

define Package/nexus-agent-router-seed/description
 Open Mesh seed profile. It includes the base Router, self-hosted Relay and
 Directory services. Initial certificates and realm state are generated by
 the guided Open Mesh seed setup and are never embedded in this package.
endef

define Package/nexus-agent-router/install
	$(INSTALL_DIR) $(1)/usr/share/nexus-agent-router/profiles
	$(INSTALL_DATA) ./files/router.json \
		$(1)/usr/share/nexus-agent-router/profiles/router.json
endef

define Package/nexus-agent-router-relay/install
	$(INSTALL_DIR) $(1)/usr/share/nexus-agent-router/profiles
	$(INSTALL_DATA) ./files/router-relay.json \
		$(1)/usr/share/nexus-agent-router/profiles/router-relay.json
endef

define Package/nexus-agent-router-seed/install
	$(INSTALL_DIR) $(1)/usr/share/nexus-agent-router/profiles
	$(INSTALL_DATA) ./files/router-seed.json \
		$(1)/usr/share/nexus-agent-router/profiles/router-seed.json
endef

$(eval $(call BuildPackage,nexus-agent-router))
$(eval $(call BuildPackage,nexus-agent-router-relay))
$(eval $(call BuildPackage,nexus-agent-router-seed))
