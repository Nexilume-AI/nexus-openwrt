# P3.1 static ARPX/1 peer registry. Disabled examples are not loaded.
# P3.1 exposes configured inventory only; the HTTP/2 session starts in P3.2.

config peer 'example_reflector'
	option enabled '0'
	option peer_id 'core-reflector'
	option router_id 'router-core-1'
	option domain_id 'eda.example'
	option endpoint 'https://router-core-1.eda.example:7444/arpx/v1'
	option connect_ipv4 '192.0.2.10'
	option role 'reflector'
	option graceful_restart_seconds '30'
