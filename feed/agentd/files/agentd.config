config core 'main'
	option enabled '1'
	option max_routes '10000'
	option default_lease_seconds '30'
	option min_lease_seconds '5'
	option max_lease_seconds '3600'
	option prune_interval_ms '1000'
	option ipc_socket '/var/run/agentd/lookup.sock'
	option ipc_allowed_uid '454'
	# Zero-configuration Public Agent IPv6. Runtime detection prefers a
	# delegated/routed prefix and otherwise verifies a global on-link /64.
	option public_ipv6_enabled '1'
	# routed-prefix: an upstream routes a PD/static prefix to this router.
	# upstream-relay: allocate /128s from the WAN on-link /64 and proxy NDP.
	option public_ipv6_mode 'auto'
	option public_ipv6_prefix ''
	option public_ipv6_max_addresses '256'
	option public_ipv6_interface 'nexus-agent0'
	option public_ipv6_upstream_interface 'wan6'
	option jail '1'
	# Open Mesh is a router-local distributed trust mode. Every directly
	# discovered/configured Router is admitted; Cloud Relay remains strict.
	option router_mesh_mode 'open'
	option peer_transport_enabled '1'
	option peer_listener_enabled '1'
	option reflector_enabled '0'
	option peer_listen_ipv4 '0.0.0.0'
	option peer_listen_port '7444'
	option peer_max_inbound '8'
	option router_id 'router-local'
	option domain_id 'local.invalid'
	option peer_ca_file '/etc/agentd/tls/peer-ca.crt'
	option peer_client_cert '/etc/agentd/tls/router.crt'
	option peer_client_key '/etc/agentd/tls/router.key'
	option peer_heartbeat_ms '5000'
	option peer_connect_timeout_ms '5000'
	option peer_open_timeout_ms '5000'
	option peer_heartbeat_miss_limit '3'
	option peer_initial_backoff_ms '250'
	option peer_max_backoff_ms '30000'
	option peer_tick_ms '100'
	option discovery_enabled '1'
	option discovery_publish_enabled '1'
	option discovery_poll_ms '5000'
	option discovery_max_candidates '64'
	option discovery_ttl_cap_seconds '120'
	# P5.2 LAN zero-configuration peer promotion. Modes: off,
	# same-domain, allowlist, all. The allowlist is comma-separated.
	option lan_auto_promotion_mode 'all'
	option lan_auto_promotion_allowlist ''
	option lan_auto_promotion_grace_seconds '30'
	# P3.6 experimental cross-domain SVCB discovery. Disabled by default.
	# The resolver must be a loopback DNSSEC-validating resolver that sets AD.
	option cross_discovery_enabled '0'
	option cross_discovery_domain 'remote.invalid'
	# Auto selects a listening local Unbound validator or a DNSSEC-enabled
	# dnsmasq. Manual mode uses the two explicit values below.
	option cross_discovery_resolver_mode 'auto'
	option cross_discovery_resolver_ipv4 '127.0.0.1'
	option cross_discovery_resolver_port '1053'
	option cross_discovery_poll_ms '60000'
	option cross_discovery_timeout_ms '1500'
	option cross_discovery_max_candidates '32'
	option cross_discovery_ttl_cap_seconds '300'
	# P6.2 signed Agent Card gate. Modes: off, same-domain, allowlist,
	# all-signed, directory-trusted. The last mode requires agent-cardd to
	# install a signed, unexpired Directory trust bundle before any Card.
	option card_authorization_mode 'off'
	option card_authorization_allowlist ''
	# P3.7 Nexus Directory -> Relay bootstrap. Disabled by default. The
	# The endpoint hostname is used for SNI/certificate verification and is
	# resolved through the system DNS resolver unless an optional IPv4 pin is
	# configured.
	option relay_enabled '0'
	option relay_directory_endpoint 'https://directory.invalid:8443/v1/relay-assignment'
	option relay_directory_connect_ipv4 ''
	# P6.2.4 HA: comma-separated, positionally paired, maximum four.
	# These plural options override the two compatible singular options above.
	option relay_directory_endpoints ''
	option relay_directory_connect_ipv4s ''
	option relay_directory_poll_ms '60000'
	option relay_directory_timeout_ms '5000'
	option relay_directory_device_token_file ''
	# Directory HTTPS is a separate trust domain from the Relay tunnel.
	# Empty preserves compatibility by falling back to peer_ca_file.
	option relay_directory_ca_file ''
	# Self-hosted Open Mesh Relay is independent from Cloud Relay.
	# The Cloud connector never writes these options.
	option open_mesh_relay_enabled '0'
	option open_mesh_directory_endpoints ''
	option open_mesh_directory_connect_ipv4s ''
	option open_mesh_directory_poll_ms '60000'
	option open_mesh_directory_timeout_ms '5000'
	# P4.1 data-plane stream on the assigned Relay HTTP/2 connection.
	# Keep disabled until the Relay endpoint implements the v1 tunnel contract.
	# Shared invoke tunnel for Relay and direct LAN ARPX peers.
	option relay_tunnel_enabled '1'
	option relay_config_generation ''
	# Relay-selected HTTPS SDK Agents are executed through agent-gw's existing
	# lease-bound TLS backend map. The credential value is file-only.
	option relay_gateway_internal_enabled '0'
	option relay_gateway_internal_endpoint 'http://127.0.0.1:7788/agent/v1/internal-invoke'
	option relay_gateway_token_file '/etc/agentd/nexus-cloud-gateway.token'
	# P6.1 target-router verification. When enabled, remote Invoke is rejected
	# unless a trusted source router supplied a valid, non-replayed assertion.
	option forwarding_assertion_required '0'
	option forwarding_public_key '/etc/agentd/forwarding-public.pem'
	option forwarding_key_id 'router-default'
	option forwarding_issuer 'router-source'
	# Separate the trusted NFA signer identity from the source Router bound in
	# each assertion. Empty preserves older configurations by using the issuer.
	option forwarding_source_router_id ''

# Disabled example. Static routes never expire and are replaced atomically
# when `ubus call agent reload` succeeds.
config route 'example_local_lint'
	option enabled '0'
	option route_id '00000000000000000000000000000001'
	option intent 'chip.verilog.verify.lint'
	option version '1'
	option origin 'agent://tenant-a/lint-local'
	option endpoint 'https://127.0.0.1:9001/invoke'
	option tenant 'tenant-a'
	option region 'local'
	option cost_microunits '10000'
	option latency_ms '50'
	option trust '90'
	option load_permille '0'
	option hop_count '0'
