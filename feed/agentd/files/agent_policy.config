# P6.3 Agent Policy RIB. Rules are compiled atomically into AFIB constraints.
config core 'main'
	option default_action 'allow'
	# Consecutive samples required before route health changes state.
	option health_failure_threshold '3'
	option health_recovery_threshold '2'

# Disabled example: keep tenant-a lint traffic local and within its SLO.
config policy 'tenant_a_lint'
	option enabled '0'
	option policy_id 'tenant-a-lint-local'
	option priority '500'
	option action 'allow'
	option tenant 'tenant-a'
	option source_agent '*'
	option intent 'chip.verilog.verify.lint.v1'
	option required_region 'local'
	option route_sources 'local,static,peer'
	option max_cost_microunits '200000'
	option max_latency_ms '3000'
	option min_trust '80'
	option max_load_permille '850'
	option max_hops '4'
	option preferred_peer ''
	option allowed_endpoint_prefix 'https://'
	option tenant_max_inflight '8'
	option tenant_rate_per_second '20'
	option tenant_rate_burst '40'
	option nonpreferred_peer_penalty '250000'
	option latency_weight '1000'
	option cost_divisor '100'
	option load_weight '100'
	option trust_weight '5000'
	option hop_weight '10000'

# Disabled example: explicit high-priority deny wins over broader allow rules.
config policy 'deny_untrusted_caller'
	option enabled '0'
	option policy_id 'deny-untrusted-caller'
	option priority '1000'
	option action 'deny'
	option tenant 'tenant-a'
	option source_agent 'agent://tenant-a/untrusted'
	option intent '*'
