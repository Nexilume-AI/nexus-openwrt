#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled config_file mode
	config_load nexus_roles
	config_get_bool enabled directory enabled 0
	config_get mode main mode
	case "$mode" in
		node-directory|all) enabled=1 ;;
		node|node-relay) enabled=0 ;;
	esac
	config_get config_file directory config_file /etc/nexus-directoryd/directory.json
	[ "$enabled" = 1 ] || return 0
	. /usr/lib/nexus-agent-roles/role-runtime.sh
	nexus_role_prepare_runtime directory || return 1

	procd_open_instance
	procd_set_param command /usr/bin/node /usr/lib/nexus-directory/nexus-directory.js --config "$config_file"
	procd_set_param user nexus-directory
	procd_set_param group nexus-directory
	# Keep slow recovery armed after crashes/config faults; explicit stop wins.
	procd_set_param respawn 3600 30 0
	procd_set_param limits nofile="2048 2048"
	procd_set_param file "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nexus_roles
}
