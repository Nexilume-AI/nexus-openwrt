#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=11

start_service() {
	local resolution ready prefix mode upstream_device
	local interface max_addresses enabled

	config_load agent
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	[ -x /usr/libexec/nexus-agent-public-ipv6 ] || {
		logger -t agent-netd "public IPv6 resolver is missing"
		return 1
	}
	resolution="$(/usr/libexec/nexus-agent-public-ipv6 resolve)" || return 1
	ready="$(printf '%s' "$resolution" | jsonfilter -e '@.ready' 2>/dev/null)"
	[ "$ready" = true ] || [ "$ready" = 1 ] || {
		logger -t agent-netd "public IPv6 is waiting: $(printf '%s' "$resolution" | jsonfilter -e '@.code' 2>/dev/null)"
		return 0
	}
	prefix="$(printf '%s' "$resolution" | jsonfilter -e '@.prefix' 2>/dev/null)"
	mode="$(printf '%s' "$resolution" | jsonfilter -e '@.effective_mode' 2>/dev/null)"
	upstream_device="$(printf '%s' "$resolution" | jsonfilter -e '@.upstream_device' 2>/dev/null)"
	[ -n "$prefix" ] || return 1
	case "$mode" in
		routed-prefix) ;;
		upstream-relay) [ -n "$upstream_device" ] || return 1 ;;
		*) logger -t agent-netd "invalid effective public IPv6 mode: $mode"; return 1 ;;
	esac

	config_get interface main public_ipv6_interface nexus-agent0
	config_get max_addresses main public_ipv6_max_addresses 256
	case "$interface" in
		nexus-agent[0-9A-Za-z_.-]*) ;;
		*) logger -t agent-netd "refusing non-dedicated interface: $interface"; return 1 ;;
	esac
	command -v ip >/dev/null 2>&1 || {
		logger -t agent-netd "base image does not provide the ip utility"
		return 1
	}
	ip link show dev "$interface" >/dev/null 2>&1 || \
		ip link add name "$interface" type dummy || return 1
	ip link set dev "$interface" up || return 1
	ip -6 address flush dev "$interface" scope global

	procd_open_instance
	procd_set_param command /usr/sbin/agent-netd
	procd_append_param command -p "$prefix"
	procd_append_param command -i "$interface"
	procd_append_param command -m "$max_addresses"
	[ "$mode" != upstream-relay ] || \
		procd_append_param command -r "$upstream_device"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/agent
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger agent network
}
