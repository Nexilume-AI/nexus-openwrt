config gateway 'main'
	option enabled '1'
	option listen '127.0.0.1:7788'
	option ipc_socket '/var/run/agentd/lookup.sock'
	option max_envelope_bytes '65536'
	option ipc_timeout_ms '200'
	option max_inflight '32'
	option rate_per_second '50'
	option rate_burst '100'
	option jail '1'
	# none permits calls without a JWT. jwt keeps the existing verifier path.
	option auth_mode 'none'
	option jwt_required '0'
	# Separate LAN listener for SDK, MCP and A2A access. It is accepted only
	# while auth_mode=none; firewall zone selection remains an administrator task.
	option no_jwt_lan_enabled '0'
	option no_jwt_lan_listen '0.0.0.0:7445'
	# Trusted-LAN listener for Python SDK registration, renewal and invocation.
	# The bridge supplies authenticated source metadata and the Router issues a
	# source-bound five-minute Session Token automatically; no Agent secret is
	# stored in UCI or entered by the application developer.
	option lan_sdk_enabled '0'
	option lan_sdk_listen '0.0.0.0:7446'
	option jwt_public_key '/etc/agent-gw/jwt-public.pem'
	option jwt_kid 'default'
	option jwt_jwks_file ''
	option jwt_jwks_url ''
	option jwt_jwks_ca_file '/etc/ssl/certs/ca-certificates.crt'
	# Managed by nexus-cloud-connectord after enrollment. The custom CA is
	# returned only inside a successful source-bound LAN bootstrap response.
	option cloud_public_origin ''
	option cloud_trust_ca_file '/etc/ssl/certs/ca-certificates.crt'
	option jwt_jwks_timeout_seconds '10'
	option jwt_jwks_refresh_seconds '300'
	option jwt_issuer 'https://issuer.invalid'
	option jwt_audience 'nexus-agent-router'
	option jwt_clock_skew_seconds '30'
	option jwt_max_lifetime_seconds '300'
	option transaction_replay_capacity '512'
	# P6.1 source-router delegation. The original Bearer JWT never leaves
	# this gateway; a short-lived, body-bound assertion is sent instead.
	option forwarding_assertion_enabled '0'
	option forwarding_private_key '/etc/agent-gw/forwarding-private.pem'
	option forwarding_key_id 'router-default'
	option forwarding_issuer 'router-local'
	option forwarding_ttl_seconds '30'
	option invoke_enabled '0'
	# Enables POST register/renew/unregister on the Agent Access Proxy.
	# Keep disabled until the listener is exposed through the mTLS edge or a
	# trusted LAN-only reverse proxy.
	option registration_enabled '0'
	option backend_timeout_ms '5000'
	# Explicit Task/Chat/Interactive manifest entries may wait for caller input.
	option interactive_backend_timeout_ms '3600000'
	option max_backend_response_bytes '262144'
	option stream_enabled '0'
	option stream_idle_timeout_ms '15000'
	option max_stream_event_bytes '65536'
	# P8.9 keeps a bounded task-to-route binding so reconnects return to the
	# original Agent instead of re-executing on a newly selected route.
	option stream_resume_enabled '1'
	option stream_resume_capacity '512'
	option stream_resume_ttl_seconds '300'
	# Normal Python SDK operation: a registered numeric RFC1918/ULA HTTP
	# endpoint becomes callable without copying it into a second UCI list.
	option lan_backend_enabled '1'
	# SDK-managed HTTPS Agents submit a lease-bound address, TLS name, CA label
	# and leaf fingerprint. The router accepts only its pre-trusted CA bundle.
	option remote_backend_enabled '1'
	option remote_backend_ca_file '/etc/ssl/certs/ca-certificates.crt'
	option remote_backend_ca_bundle_id 'system'
	# Private agentd -> Gateway bridge for Relay-selected HTTPS SDK Agents.
	# The credential itself is never stored in UCI or passed via argv/env.
	option internal_invoke_enabled '0'
	option internal_invoke_token_digest_file '/etc/agent-gw/nexus-cloud-gateway-token.sha256'
	# Public, non-secret rollout identifier. The connector changes it whenever
	# the internal verifier/config must be reloaded and waits for an exact echo.
	option internal_invoke_generation ''
	# Exact TLS identity and port pinned to numeric IPv4 or [IPv6]. Up to 16.
	# list remote_backend_map 'agent.example.test:7443=192.0.2.10'
	# list remote_backend_map 'agent-v6.example.test:7443=[2001:db8::10]'
	option retry_enabled '0'
	option max_route_attempts '2'
	option retry_attempt_timeout_ms '1500'
	option retry_min_remaining_ms '100'
	# P8.12.2 is activated by agentd.public_ipv6_enabled.  Only the local
	# stunnel -> agent-edge-bridge path can attach the matching edge token.
	option public_ingress_token_file '/var/run/agent-gw/public-ingress.token'
	# auto preserves older mtls_enabled configurations. New installations can
	# explicitly select mtls, http (cleartext + JWT), or disabled in LuCI.
	option public_transport 'auto'
	option mtls_enabled '0'
	option mtls_listen '[::]:7443'
	option mtls_server_cert '/etc/agent-gw/tls/server.crt'
	option mtls_server_key '/etc/agent-gw/tls/server.key'
	option mtls_client_ca '/etc/agent-gw/tls/client-ca.crt'
	option mtls_tls_min '1.3'
	option public_ingress_bridge_listen '127.0.0.1:7791'
	option public_ingress_adapter_backend '127.0.0.1:7790'
	option public_ingress_port '7443'
	option public_ingress_max_connections '32'
	# When enabled, public IPv6 registration responses include a portable
	# direct-connection descriptor. The TLS name must be present in the edge
	# certificate DNS SAN. ca_bundle_id is a label, never a filesystem path.
	option public_descriptor_enabled '0'
	option public_tls_server_name ''
	option public_ca_bundle_id ''
